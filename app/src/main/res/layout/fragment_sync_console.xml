<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bulut senkron konsolu"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Bulut senkron konsolu" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Retrofit + REST (JSONPlaceholder HTTPS demo). Ölçümler önce Room outbox’a yazılır; internet gelince WorkManager ile gönderilir."
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Bekleyen gönderim"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pendingCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Uzak özet (GET cache)"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/remoteSnippet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp" />

        <Button
            android:id="@+id/buttonSyncNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Şimdi senkronla" />

        <Button
            android:id="@+id/buttonDeleteLatest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Son ölçümü sil (CRUD)" />

        <Button
            android:id="@+id/buttonClose"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Kapat" />

    </LinearLayout>
</ScrollView>
